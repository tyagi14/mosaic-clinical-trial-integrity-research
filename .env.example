# ============================================================================
# MOSAIC — environment template
#
# Copy this file to .env and fill in the real values:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. Everything here is read
# exactly once, at startup, by config/settings.py. A missing REQUIRED value
# makes the app fail immediately with a clear message rather than halfway
# through an analysis run.
# ============================================================================

# ── OPENAI (required) ───────────────────────────────────────────────────────
# Used for both agent reasoning and embeddings. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-me

# Must match the model the stored chunks were embedded with. Changing it
# invalidates every embedding in the database — re-run processing after a
# change, or searches will return nonsense.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# The reasoning model for all six specialist agents.
OPENAI_CHAT_MODEL=gpt-4o

# ── LANGSMITH TRACING (optional) ────────────────────────────────────────────
# Leave LANGSMITH_API_KEY empty to run without tracing. config/settings.py
# force-disables tracing when the key is empty, because tracing switched on
# without a key makes every LLM call log an auth warning.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clinical_trial_intelligence
LANGSMITH_TRACING_V2=false

# ── GOOGLE CLOUD (required) ─────────────────────────────────────────────────
# GCS_BUCKET_NAME is where ingestion archives raw and parsed documents.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=your-bucket-name

# ── CLOUD SQL / POSTGRES (required) ─────────────────────────────────────────
# DB_HOST takes two forms:
#   local development → the Cloud SQL instance's public IP, e.g. 35.223.176.196
#                       (your IP must be in the instance's authorised networks)
#   Cloud Run         → the injected socket path, e.g.
#                       /cloudsql/PROJECT:REGION:INSTANCE
# The database must have the pgvector extension and the schema from
# deployment/gcp/cloudsql_init.sql applied.
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=clinical_trial_db
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ── EXTERNAL DATA SOURCES (defaults are fine) ───────────────────────────────
CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICAL_TRIALS_PAGE_SIZE=100
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# ── API SERVER ──────────────────────────────────────────────────────────────
# 0.0.0.0 is required on Cloud Run so the container is reachable.
# API_ENV=development opens CORS to all origins; production locks it down.
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
